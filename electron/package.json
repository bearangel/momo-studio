{
  "name": "@ap/electron",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"electron .\"",
