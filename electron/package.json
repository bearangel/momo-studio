{
  "name": "momo-studio-electron",
  "private": true,
  "version": "2.0.0",
  "description": "Momo Studio — 个人桌面端多 agent 协作平台",
  "author": "Momo Studio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bearangel/momo-studio.git"
  },
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"electron .\"",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build && pnpm --filter ../renderer build && electron-builder",
    "pack": "pnpm build && pnpm --filter ../renderer build && electron-builder --dir"
  },
  "build": {
    "appId": "io.momo-studio.desktop",
    "productName": "Momo Studio",
    "directories": {
      "output": "dist-installers",
      "buildResources": "build"
    },
    "publish": null,
    "executableName": "momo-studio",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "./resources/agents",
        "to": "agents"
      },
      {
        "from": "../resources/marketplace",
        "to": "marketplace"
      },
      {
        "from": "../renderer/dist",
        "to": "renderer"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Momo Studio",
      "executableName": "momo-studio"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.0.0",
    "bonjour-service": "^1.4.4",
    "cheerio": "1",
    "electron-log": "^5.1.0",
    "fast-glob": "3",
    "ignore": "5",
    "js-yaml": "^5.2.2",
    "keytar": "^7.9.0",
    "simple-git": "^3.36.0",
    "turndown": "7",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "typescript-language-server": "4",
    "vitest": "^1.6.0"
  }
}