{
  "name": "momo-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Personal desktop multi-agent collaboration platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter ./electron dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "postinstall": "pnpm --filter ./renderer postinstall"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.0.0",
    "playwright": "^1.48.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}