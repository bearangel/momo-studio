{
  "servers": {
    "codegraph": {
      "command": "${engineNode}",
      "args": [
        "${pluginRoot}/bin/boot.js",
        "--engine", "${engineBin}",
        "--root", "${config.workspaceRoot}"
      ],
      "env": {
        "CODEGRAPH_NO_DOWNLOAD": "1",
        "CODEGRAPH_DIR": ".momo-codegraph"
      }
    }
  }
}
